# Unapproved rollout template; credentials must come from approved private secret selectors.
SPECCHECK_MODE=live
CONTROLLER_STATE_DIR=/controller
CAMPAIGN_BUDGET_FILE=/controller/campaign.sqlite3
BUDGET_USD_PER_RUN=3
BUDGET_USD_PER_DAY=8
BUDGET_TAVILY_CREDITS_PER_ITEM=60
BUDGET_TAVILY_CREDITS_PER_DAY=600
MAX_CONCURRENCY=2
THINKING=off
# The already authorized targeted quality profile; final release must validate this exact configuration.
MAX_OUTPUT_TOKENS=32768
INVESTIGATE_MAX_STEPS=24
INVESTIGATE_CREDIT_CAP=30
FIX_CREDIT_CAP=40
# Keep launcher identity, image and URL unset until manual job commissioning is approved.
# ENABLE_NEBIUS_JOBS is a GitHub repository variable; it is not an application environment switch.
