# mock = replay fixtures, no API calls. live = real calls to Token Factory and Tavily (cached).
SPECCHECK_MODE=mock

NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
TAVILY_API_KEY=

# Confirm exact IDs in the Token Factory console before going live.
MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_OMNI=nvidia/Nemotron-3-Nano-Omni
MODEL_SUPER=nvidia/Nemotron-3-Super-120B-A12B
MODEL_ULTRA=nvidia/Nemotron-3-Ultra

# Max documents processed at once (Token Factory returns 429 when over the limit).
MAX_CONCURRENCY=4
