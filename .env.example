# Copy to .env (never committed). Empty values fall back to the defaults in api/config.py.
# Mock mode needs no keys at all.

# mock = replay fixtures, no API calls. live = real calls to Token Factory and Tavily (cached in .cache/).
# live with a missing NEBIUS_API_KEY or TAVILY_API_KEY stops at startup, naming the variable.
SPECCHECK_MODE=mock

# --- Keys (never logged, never returned by the API; /api/health only says true/false) ---
# Nebius Token Factory key (Nemotron models).
NEBIUS_API_KEY=
# OpenAI-compatible endpoint.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Tavily search/extract/map key.
TAVILY_API_KEY=
# Administrative runs and scoring in live mode need this sent as the X-Admin-Token header.
# Public /api/scan calls share the rate/day caps; admin bypasses only the rate limit.
ADMIN_TOKEN=
# Separate signed worker callbacks. Workers receive this credential, never ADMIN_TOKEN.
WORKER_TOKEN=

# --- Models per task (confirm IDs with: python scripts/spike_models.py) ---
# Default nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_TRIAGE=
# Default nvidia/nemotron-3-super-120b-a12b (all three)
MODEL_EXTRACT=
MODEL_VERIFY=
MODEL_WRITE=
# Checklist drafting from a spec PDF only. Default Super; nvidia/Nemotron-3-Ultra-550b-a55b is priced in api/config.py.
MODEL_DRAFT=

# Nemotron 3 thinks before it answers unless told not to. THINKING_TASKS can opt selected tasks into reasoning.
# off (default) sends reasoning_effort=none + chat_template_kwargs.enable_thinking=false
# (a server that rejects a field is retried without it); on leaves the model's default. Check with scripts/spike_models.py.
THINKING=off

# --- Budget caps (a cap marks the step "couldn't confirm"; the run goes on) ---
# Live admission also requires initialized campaign accounting. See scripts/campaign_budget.py.
# Local SQLite file; never place it on an object-storage mount. Missing/corrupt accounting blocks paid calls.
CAMPAIGN_BUDGET_FILE=
# Hosted controller only: dedicated mounted POSIX filesystem, bound to one VM writer.
# Docker startup derives persistent app paths under <mount>/app; image inputs stay immutable.
# Set CAMPAIGN_BUDGET_FILE=<mount>/campaign.sqlite3 and import the existing authority explicitly.
# Jobs must never receive this mount.
CONTROLLER_STATE_DIR=
# Model spend per run, USD. Default 1. Each call's worst case is checked first, so a cap is never overshot.
BUDGET_USD_PER_RUN=
# Model spend per UTC day, across runs (live, uncached calls). Default 2.
BUDGET_USD_PER_DAY=
# Longest model reply, in tokens. Default 8192. A reply cut off here fails that step instead of retrying.
MAX_OUTPUT_TOKENS=
# Tavily credits per item (one submittal). Default 25.
BUDGET_TAVILY_CREDITS_PER_ITEM=
# Tavily credits per UTC day, across runs. Default 150.
BUDGET_TAVILY_CREDITS_PER_DAY=

# --- Uploads ---
PUBLIC_UPLOADS_LIVE=true
# Set false to force public uploads to mock; the admin token still permits live uploads.
MAX_UPLOAD_MB=15
# Per client IP. Default 10.
UPLOADS_PER_IP_PER_HOUR=

# Max documents processed at once (Token Factory returns 429 when over the limit). Default 4.
MAX_CONCURRENCY=

# --- Nebius Serverless Jobs (unset credentials keep the app action hidden) ---
NEBIUS_SA_ID=
NEBIUS_PUBLIC_KEY_ID=
NEBIUS_PRIVATE_KEY=
NEBIUS_PROJECT_ID=
SPECCHECK_IMAGE=
# HTTPS origin only, with no path, query, fragment or credentials.
SPECCHECK_URL=
# MysteryBox selectors, NOT key values. Match the secret payload names to the env names.
NEBIUS_SECRET_NEBIUS_API_KEY=
NEBIUS_SECRET_TAVILY_API_KEY=
NEBIUS_SECRET_WORKER_TOKEN=
WATCH_RUN_INTERVAL_S=3600
# TODO(owner): add exact CLI-observed states after the first real job. Unknown states stay in flight.
NEBIUS_JOB_STATE_MAP={"COMPLETED":"done"}
# Local directory or bucket mount. Unset skips archiving. Use label "Nebius Object Storage" for that mount.
EVIDENCE_DIR=
EVIDENCE_LABEL=disk
# Jobs return signed evidence to the controller; they do not mount the archive or accounting disk.

# --- Quality tuning (measure one knob at a time with eval --out) ---
# Comma-separated router task names, e.g. verify,investigate. These use model-default thinking.
THINKING_TASKS=
MAX_PAGE_CHARS=6000
WEB_SOURCE_CHARS=12000
SEARCH_DEPTH=basic
EXTRACT_DEPTH=basic
SEARCH_MAX_RESULTS=5
INVESTIGATE_CREDIT_CAP=8
INVESTIGATE_MAX_STEPS=6
MAP_LIMIT=20
